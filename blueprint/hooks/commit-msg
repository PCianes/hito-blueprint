#!/bin/sh
# Enabled with: git config core.hooksPath blueprint/hooks
# Extension point: runs custom/hooks/commit-msg, if the owner has one, with the message file.
# It is run with sh, so it works even if a copy lost its executable bit.
f="$(git rev-parse --show-toplevel)/custom/hooks/commit-msg"
[ -f "$f" ] || exit 0
exec sh "$f" "$1"
