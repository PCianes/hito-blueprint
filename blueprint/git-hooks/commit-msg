#!/bin/sh
# Enabled with: git config core.hooksPath blueprint/git-hooks
# Where the base is developed, stops a message with personal text. Extension point: runs custom/git-hooks/commit-msg, if the owner has one, with the message file.
# It is run with sh, so it works even if a copy lost its executable bit.
top=$(git rev-parse --show-toplevel)
# Where the base is developed, the message is public: check.sh stops Spanish and personal data.
if [ "$(git config --bool hito.develop 2> /dev/null)" = true ]; then
  sh "$top/blueprint/scripts/check.sh" --message "$1" || exit 1
fi
f="$top/custom/git-hooks/commit-msg"
[ -f "$f" ] || exit 0
exec sh "$f" "$1"
